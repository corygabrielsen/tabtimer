{
  "name": "tabtimer",
  "private": true,
  "version": "1.0.0",
  "description": "A chrome extension to help you watch how much time you've spent on a website as an overlay.",
  "type": "module",
  "author": "Cory Gabrielsen <corygabrielsen@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.content.config.ts",
    "watch": "vite build --watch",
    "package": "pnpm run build && cd dist && zip -r ../tabtimer.zip . -x '.vite/*'",
    "clean": "rm -rf dist tabtimer.zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"vite.config.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.3.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
