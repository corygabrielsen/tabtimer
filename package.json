{
  "name": "tabtimer",
  "private": true,
  "version": "1.11.0",
  "description": "Counts your active time on the sites you choose and blocks them when you hit your daily limit.",
  "type": "module",
  "author": "Cory Gabrielsen <corygabrielsen@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-build.ts",
    "watch": "vite build --watch",
    "package": "pnpm run build && rm -f tabtimer.zip && cd dist && zip -r ../tabtimer.zip . -x '.vite/*'",
    "clean": "rm -rf dist tabtimer.zip",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "TABTIMER_E2E=1 pnpm run build && playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "tldts": "^7.4.19"
  }
}
